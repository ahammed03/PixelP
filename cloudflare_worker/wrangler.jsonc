{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pixelp-instagram-publisher",
  "main": "src/index.js",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["30 12 * * *"]
  },
  "r2_buckets": [
    {
      "binding": "PIXELP_BUCKET",
      "bucket_name": "pixelp"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "PIXELP_KV",
      "id": "bbe264e595ba402a9c4cbd08590daeff"
    }
  ],
  "vars": {
    "PUBLIC_MEDIA_BASE_URL": "https://pub-1e1f03cba3ca4491893c12cf937eb996.r2.dev",
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "INSTAGRAM_API_VERSION": "v24.0",
    "LAST_PUBLISHED_KV_KEY": "instagram:last_published",
    "PUBLISH_ENABLED": "true"
  }
}
