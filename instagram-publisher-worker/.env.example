# Local reference only. Production values should be stored with Wrangler.
GEMINI_API_KEY=<gemini-api-key>
INSTAGRAM_ACCESS_TOKEN=<instagram-access-token>
INSTAGRAM_USER_ID=<instagram-professional-account-id>
PUBLISH_TRIGGER_SECRET=<manual-trigger-secret>

# These are also declared in wrangler.jsonc.
PUBLIC_MEDIA_BASE_URL=https://<public-r2-host>
GEMINI_MODEL=gemini-3.5-flash-lite
INSTAGRAM_API_VERSION=v24.0
LAST_PUBLISHED_KV_KEY=instagram:last_published
PUBLISH_ENABLED=true
